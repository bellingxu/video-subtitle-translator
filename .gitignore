# ─────────────────────────────────────────────────────────────
#  这个文件告诉 git：下面这些东西“永远不要上传”。
# ─────────────────────────────────────────────────────────────

# 你的设置、DeepSeek API Key（data/secrets.json）、识别和翻译的缓存
# —— 全是个人数据，不要上传到任何地方
data/

# 多一道保险：不管放在哪个文件夹，这些名字的文件一律不上传
secrets.json
secrets.*.json
*.secret
.env
.env.*

# 运行环境（约 1 GB，运行 install.sh 会自动重建）
runtime/
.install-tmp/

# 开发工具自己的配置（里面有本机的文件路径）
.claude/
.vscode/
.idea/

# 程序运行时自动产生的临时文件
__pycache__/
*.pyc
.partial-*.mp4

# macOS 自动生成的
.DS_Store
